# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./data/jobs.db

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_PROXY_URL=
TELEGRAM_CHAT_ID=

# --- Browser ---
HEADLESS=true
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080
LOCALE=ru-RU
TIMEZONE_ID=Europe/Moscow

# --- Rate limiting (секунды) ---
DELAY_MIN=2.0
DELAY_MAX=5.0

# --- HH.ru ---
HH_BASE_URL=https://krasnodar.hh.ru/search/vacancy
HH_DEFAULT_TEXT=Python
HH_WAIT_UNTIL=domcontentloaded

# --- Search ---
SEARCH_LIMIT=100
RESULTS_PAGE_SIZE=5
