# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./data/jobs.db

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Если Telegram открывается только через VPN/прокси, например http://127.0.0.1:10809
TELEGRAM_PROXY_URL=
# Если api.telegram.org заблокирован: свой адрес Bot API (например, Cloudflare Worker)
TELEGRAM_API_BASE=
# Переиспользовать соединения: пусто = авто (выключено при своём TELEGRAM_API_BASE)
TELEGRAM_KEEPALIVE=
# Секунд на один запрос к Telegram
TELEGRAM_TIMEOUT=15

# --- Browser ---
HEADLESS=true
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080
LOCALE=ru-RU
TIMEZONE_ID=Europe/Moscow

# --- Rate limiting (секунды) ---
DELAY_MIN=2.0
DELAY_MAX=5.0

# --- HH.ru ---
HH_BASE_URL=https://krasnodar.hh.ru/search/vacancy
HH_WAIT_UNTIL=domcontentloaded

# --- Search ---
SEARCH_LIMIT=100
# Предел на весь поиск, секунд
SEARCH_TIMEOUT_SECONDS=300
RESULTS_PAGE_SIZE=5
# id региона HH для шаблона «удалёнка везде + мой город офис/гибрид» (53 — Краснодар, 1 — Москва, 2 — СПб)
HOME_AREA_ID=53

# --- Subscriptions ---
# Как часто проверять подписки, минут
SUBSCRIPTION_INTERVAL_MINUTES=15
# Если новых больше — придёт одна сводка вместо отдельных карточек
SUBSCRIPTION_MAX_PER_CHECK=10
# Тихие часы по времени компьютера, например 23-8 (пусто — выключено)
QUIET_HOURS=
